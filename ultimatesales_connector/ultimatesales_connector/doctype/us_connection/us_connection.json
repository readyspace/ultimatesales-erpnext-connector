  "track_changes": 0,
  "allow_rename": 0,
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "setup_section",
    "setup_checklist",
    "connection_name",
    "enabled",
    "preview_only",
    "routing_section",
    "company",
    "crm_currency",
    "integration_user",
    "location_id",
    "pipeline_id",
    "qualified_stage_id",
    "credential_section",
    "api_token",
    "export_section",
    "allow_quotation_export",
    "export_contract_verified",
